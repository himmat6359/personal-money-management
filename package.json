{
  "name": "mymoney-android",
  "version": "1.0.0",
  "private": true,
  "description": "MyMoney Android wrapper using the existing web app and Supabase",
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('www',{recursive:true});require('fs').copyFileSync('index.html','www/index.html')\"",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@capacitor/android": "7.4.3"
  }
}
